# ─── CORE — Obrigatório antes de qualquer build de produção ──────────────────
# URL base do site (sem barra final). Usada em canonical, OG tags, sitemap e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://pizzarte.com
# Nome do site. Aparece nos títulos de página, OG tags e schemas Organization/Restaurant.
NEXT_PUBLIC_SITE_NAME=Pizzarte

# ─── CONTACTO — Enriquece os schemas Organization e Restaurant (JSON-LD) ─────
# Cada variável é opcional; o schema omite o campo se estiver vazio.
NEXT_PUBLIC_PHONE=+351 234 427 103
NEXT_PUBLIC_EMAIL=pizzarte@pizzarte.com
NEXT_PUBLIC_ADDRESS=R. Engº Von Haff, 27
NEXT_PUBLIC_CITY=Aveiro
NEXT_PUBLIC_POSTAL_CODE=3800-177

# ─── GEO — Coordenadas para GeoCoordinates no schema Restaurant ──────────────
# Confirmado no OpenStreetMap (nó "Pizzarte" já mapeado).
NEXT_PUBLIC_GEO_LAT=40.6443152
NEXT_PUBLIC_GEO_LNG=-8.6454456

# ─── REDES SOCIAIS — Array `sameAs` no schema Organization ───────────────────
# Apenas preencher os perfis que existem; valores vazios são ignorados automaticamente.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/pizzarte_restaurante/
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/pizzarte/
